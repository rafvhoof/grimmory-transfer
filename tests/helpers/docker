#!/usr/bin/env bash
set -Eeuo pipefail
printf 'docker %s\n' "$*" >> "$MOCK_LOG"
command="$1"; shift
if [[ "${MOCK_HANG_DOCKER:-}" == "$command" ]]; then
  # Emulate a wedged Docker client that does not stop on the first TERM.
  trap '' TERM
  exec sleep 60
fi
case "$command" in
  inspect)
    [[ "${1:-}" == --format ]] || exit 0
    case "$2" in
      *'.State.Running'*)
        if [[ "$3" == mariadb || "$3" == grimmory-db ]]; then echo true; else cat "$MOCK_APP_STATE"; fi ;;
      *'.Config.Image'*) echo "${MOCK_IMAGE:-ghcr.io/grimmory/grimmory:1.0.0}" ;;
      *'{{.Image}}'*) echo "${MOCK_IMAGE_ID:-sha256:test-image}" ;;
      *'.Mounts'*) printf '/app/data\n/books\n/bookdrop\n' ;;
      *) exit 30 ;;
    esac
    ;;
  image)
    [[ "$1" == inspect && "${@: -1}" == sha256:test-image ]]
    printf 'ghcr.io/grimmory-tools/grimmory@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
    ;;
  stop) printf 'false\n' > "$MOCK_APP_STATE" ;;
  start) printf 'true\n' > "$MOCK_APP_STATE" ;;
  rm)
    [[ "$1" == -f && "$2" == bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb ]]
    [[ "${MOCK_FAIL_HELPER_CLEANUP:-0}" == 0 ]] || exit 35
    rm -f -- "$MOCK_LOG.helper-active"
    ;;
  run)
    cidfile=''
    args=("$@")
    for ((i=0; i<${#args[@]}; i++)); do
      if [[ "${args[i]}" == --cidfile ]]; then
        cidfile="${args[i+1]}"
        [[ ! -e "$cidfile" ]]
        printf '%s\n' "$cidfile" >> "$MOCK_LOG.cidfiles"
        printf '%s\n' bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb > "$cidfile"
        : > "$MOCK_LOG.helper-active"
        [[ " $* " == *' --init '* ]]
        break
      fi
    done
    if [[ " $* " == *' du -sk '* ]]; then
      if [[ "${MOCK_HANG_SCAN:-0}" == 1 ]]; then
        trap '' TERM
        exec sleep 60
      fi
      [[ "${MOCK_FAIL_SCAN:-0}" == 0 ]] || exit 36
      printf '1 %s\n' "${@: -1}"
    elif [[ " $* " == *' sh -c '* ]]; then
      [[ "${MOCK_NONEMPTY_MOUNT:-0}" == 0 ]]
    elif [[ " $* " == *' -czf '* ]]; then
      [[ "${MOCK_FAIL_ARCHIVE:-0}" == 0 ]] || exit 37
      if [[ -n "${MOCK_SIGNAL_EXPORT:-}" ]]; then
        kill -s "$MOCK_SIGNAL_EXPORT" "$PPID"
        exit 130
      fi
      directory='' archive=''
      while (( $# > 0 )); do
        case "$1" in
          -v) directory="${2%:/backup}"; shift 2 ;;
          /backup/*) archive="${1#/backup/}"; shift ;;
          *) shift ;;
        esac
      done
      tar -czf "$directory/$archive" -C "$MOCK_CONTENT" .
    elif [[ " $* " == *' -xzf '* ]]; then
      printf 'RESTORE mount\n' >> "$MOCK_WRITES"
    else
      exit 31
    fi
    if [[ -n "$cidfile" ]]; then
      rm -f -- "$cidfile" "$MOCK_LOG.helper-active"
    fi
    ;;
  exec)
    if [[ " $* " == *' mariadb-dump '* ]]; then
      [[ "${MOCK_FAIL_DUMP:-0}" == 0 ]] || exit 32
      printf 'SELECT 1;\n'
    elif [[ " $* " == *'SHOW TABLES;'* ]]; then
      [[ "${MOCK_TABLES:-0}" == 0 ]] || printf 'existing_table\n'
    elif [[ " $* " == *'information_schema.tables'* ]]; then
      printf '0\n'
    elif [[ " $* " == *' -i '* ]]; then
      cat >/dev/null
      printf 'RESTORE database\n' >> "$MOCK_WRITES"
    else
      exit 33
    fi
    ;;
  *) exit 34 ;;
esac
