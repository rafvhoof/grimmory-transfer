# Copy to /etc/grimmory-transfer.env on BOTH hosts, then chmod 600 that file.
# Alternatively set TRANSFER_ENV_FILE to a private configuration path.
# Bash sources this file: quote passwords and values containing shell characters.

NC_URL='https://nextcloud.example.com'
NC_USER='your-nextcloud-user'
NC_APP_PASSWORD='replace-with-app-password'
# NC_URL is the base URL (including any installation subdirectory), without DAV.
NC_REMOTE_ROOT='GrimmoryMigration'

# Set these to the actual container names and DB credentials on EACH host.
# Existing BookLore-era source: APP_CONTAINER=booklore, DB_CONTAINER=mariadb.
# New compose/grimmory.yml target: APP_CONTAINER=grimmory, DB_CONTAINER=grimmory-db.
# On both hosts, keep DB_NAME/DB_USER equal to the source MYSQL_DATABASE/DB_USER.
APP_CONTAINER=grimmory
DB_CONTAINER=mariadb
DB_NAME=grimmory
DB_USER=grimmory
DB_PASSWORD='REPLACE_ME'

# One local staging copy; no additional tar/zip of the complete bundle is made.
# GRIMMORY_TRANSFER_WORKDIR=/mnt/large-temporary-storage/grimmory-transfer
# Default: /var/tmp/grimmory-transfer. BACKUP_DIR remains a legacy alias.
# UTILITY_IMAGE=alpine:3.20

# Unlike Paperless, automatic source restart remains the default (0).
# Set to 1 explicitly for the final cutover; any export/upload failure restarts it.
# LEAVE_GRIMMORY_STOPPED=1

# Optional: select an exact bundle; otherwise import chooses the newest complete
# grimmory-YYYYMMDDTHHMMSSZ folder. Export generates that timestamped ID by default.
# MIGRATION_ID=grimmory-20261022T190000Z

# Optional transport controls, matching the Paperless transfer conventions.
# AUTO_INSTALL_RCLONE=0
# RCLONE_TRANSFERS=4
# RCLONE_CHECKERS=8
# NC_CONNECT_TIMEOUT=10
# NC_IO_TIMEOUT=30
# SPACE_MARGIN_PERCENT=25
# SPACE_MARGIN_BYTES=536870912
