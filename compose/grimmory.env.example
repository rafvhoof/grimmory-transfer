# Merge these values into the DESTINATION Arr stack's private .env.
# Keep unrelated existing settings. This is separate from /etc/grimmory-transfer.env.

# Paste a RepoDigest of the image used by the running source container (see README).
# Example form: ghcr.io/grimmory-tools/grimmory@sha256:<64 hexadecimal characters>
GRIMMORY_IMAGE=

# Copy the existing source MYSQL_DATABASE and DB_USER values, even if named booklore.
GRIMMORY_DB_NAME=
GRIMMORY_DB_USER=
GRIMMORY_DB_PASSWORD=
# Use a separate strong root password on the fresh destination database.
GRIMMORY_DB_ROOT_PASSWORD=
GRIMMORY_DB_IMAGE=lscr.io/linuxserver/mariadb:11.4.8

# Keep the existing Arr PUID/PGID; compare with old APP_USER_ID/APP_GROUP_ID.
# Check target ownership if those differ. Copy/check DB_USER_ID and DB_GROUP_ID.
PUID=1000
PGID=1000
DB_USER_ID=1000
DB_GROUP_ID=1000
TZ=Europe/Amsterdam

# Copy the old BOOKLORE_PORT here to retain the external port if it is not 6060.
# The app uses SERVER_PORT=6060 inside Docker.
GRIMMORY_PORT=6060

# Shared-books mode: bind the SAME existing Synology library, with identical
# relative paths inside /books. Default full-copy mode: use an empty library.
GRIMMORY_BOOKS_PATH=/mnt/media/books
GRIMMORY_DISK_TYPE=NETWORK
# Full-copy mode needs rw for import. Shared mode never writes /books during
# import; use ro for a library managed elsewhere, or rw if Grimmory manages it.
GRIMMORY_BOOKS_ACCESS=rw
